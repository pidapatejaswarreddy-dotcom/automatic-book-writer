# Server
PORT=5000
DATA_DIR=./data

# ---- AI provider ----
# Leave AI_API_KEY empty to run in DEMO MODE (sample content, no network calls).

# Option A: Google Gemini (uses Google's OpenAI-compatible endpoint)
AI_PROVIDER=openai
AI_API_KEY=
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_MODEL=gemini-2.5-flash
# Optional: if Gemini answers come back short or empty, try: AI_REASONING_EFFORT=none
AI_REASONING_EFFORT=

# Option B: Anthropic (replace the block above with this)
# AI_PROVIDER=anthropic
# AI_API_KEY=
# AI_MODEL=
