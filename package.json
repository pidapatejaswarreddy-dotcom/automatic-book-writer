{
  "name": "automatic-book-writer",
  "version": "1.0.0",
  "description": "AI-powered web application that writes a complete book chapter by chapter and exports PDF, DOCX and TXT.",
  "type": "module",
  "private": true,
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test",
    "test:ui": "node --import ./tests/helpers/register-ui.mjs tests/helpers/ui-smoke.mjs",
    "test:all": "npm test && npm run test:ui"
  },
  "engines": {
    "node": ">=18.17"
  },
  "license": "MIT",
  "dependencies": {
    "@fontsource/noto-sans": "^5.3.0",
    "@fontsource/noto-sans-devanagari": "^5.3.0",
    "@fontsource/noto-sans-kannada": "^5.3.0",
    "@fontsource/noto-sans-malayalam": "^5.3.0",
    "@fontsource/noto-sans-math": "^5.3.0",
    "@fontsource/noto-sans-tamil": "^5.3.0",
    "@fontsource/noto-sans-telugu": "^5.3.0",
    "docx": "^9.8.1",
    "dotenv": "^16.6.1",
    "express": "^4.22.3",
    "pdfkit": "^0.15.2"
  },
  "devDependencies": {
    "jsdom": "^30.1.1"
  }
}